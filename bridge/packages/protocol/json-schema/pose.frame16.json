{
  "title": "pose.frame16",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "16 字节空口帧（Quest/PC → C5），小端。UDP / ESP-NOW / BLE 三种传输共用。",
  "type": "array",
  "minItems": 16,
  "maxItems": 16,
  "items": { "type": "integer", "minimum": 0, "maximum": 255 },
  "$defs": {
    "layout": {
      "type": "object",
      "properties": {
        "0": { "type": "integer", "const": 0, "description": "u16 magic = 0xA55A" },
        "2": { "type": "integer", "description": "u16 seq" },
        "4": { "type": "integer", "description": "i16 yaw_cdeg（度×100）" },
        "6": { "type": "integer", "description": "i16 pitch_cdeg（度×100）" },
        "8": { "type": "integer", "description": "i16 yaw_rate（度/秒×10）" },
        "10": { "type": "integer", "description": "i16 pitch_rate（度/秒×10）" },
        "12": { "type": "integer", "description": "u16 flags：0x01 VALID / 0x04 RECENTER / 0x08 ESTOP" },
        "14": { "type": "integer", "description": "u16 crc16 前 14 字节，CCITT 0x1021 init 0xFFFF" }
      },
      "required": ["0", "2", "4", "6", "8", "10", "12", "14"],
      "additionalProperties": false
    }
  }
}
